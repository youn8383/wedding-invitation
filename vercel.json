{
  "rewrites": [
    {
      "source": "/i/:code",
      "destination": "/api/i?code=:code"
    },
    {
      "source": "/cafe",
      "destination": "/cafe.html"
    }
  ],
  "headers": [
    {
      "source": "/images/gallery/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
